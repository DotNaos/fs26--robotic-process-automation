MOODLE_API_KEY=
GEMINI_API_KEY=
RECIPIENT_EMAIL=
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
SEND_EMAIL=false

# Optional defaults
MOODLE_BASE_URL=https://moodle-services.os-home.net
GEMINI_MODEL=gemini-2.5-flash
SEMESTER_FILTER=FS26
# Markdown-Dateien werden im Dokumente-Ordner erzeugt und danach als HTML/PDF gerendert.
