MOODLE_API_KEY=
GEMINI_API_KEY=
RECIPIENT_EMAIL=
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
SEND_EMAIL=false

# Optional defaults
MOODLE_BASE_URL=https://moodle-services.os-home.net
GEMINI_MODEL=gemini-2.5-flash
SEMESTER_FILTER=FS26
# Ausgaben werden im Projekt unter output/YYYY-MM-DD-run-XX erzeugt.
# Pro Kurs entstehen eine HTML-Datei, eine PDF-Datei und eine .sources.json mit den verwendeten Moodle-Quellen.
# SMTP_FROM_ADDRESS=name+uipath-moodle@gmail.com

# Optional SMTP override, for example Mailpit:
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_ENABLE_SSL=false
# SMTP_FROM_ADDRESS=uipath-moodle@localhost
