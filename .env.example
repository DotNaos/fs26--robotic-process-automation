GEMINI_API_KEY=
RECIPIENT_EMAIL=
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
SEND_EMAIL=true

# Optional defaults
MOODLE_BASE_URL=http://127.0.0.1:8080
# Only needed when using the public Moodle Services API instead of local Docker.
MOODLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
SEMESTER_FILTER=FS26
# Ausgaben werden im Projekt unter output/YYYY-MM-DD-run-XX erzeugt.
# Pro Kurs entstehen eine HTML-Datei, eine PDF-Datei und eine .sources.json mit den verwendeten Moodle-Quellen.

# Local Mailpit SMTP defaults.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_ENABLE_SSL=false
SMTP_FROM_ADDRESS=uipath-moodle@localhost

# Local Docker Moodle Services login. Prefer setting these in your shell for docker compose
# instead of committing them to a file.
# MOODLE_USERNAME=
# MOODLE_PASSWORD=
# MOODLE_CALENDAR_URL=
