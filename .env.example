MOODLE_API_KEY=
MOODLE_USERNAME=
MOODLE_PASSWORD=
GEMINI_API_KEY=
RECIPIENT_EMAIL=
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
SEND_EMAIL=false

# Optional defaults
MOODLE_BASE_URL=http://127.0.0.1:8080
GEMINI_MODEL=gemini-flash-latest
SEMESTER_FILTER=FS26
# Optional: limit a run to one or more Moodle course IDs, separated by comma.
# COURSE_FILTER=22576
# Markdown-Dateien werden im Dokumente-Ordner erzeugt und danach als HTML/PDF gerendert.
# SMTP_FROM_ADDRESS=schuetzoliver00@gmail.com

# Optional SMTP override, for local Mailpit from compose.yaml:
